{
  "biome": {
    "command": [
      "biome",
      "lsp-proxy"
    ],
    "extensions": [
      ".ts",
      ".tsx",
      ".js",
      ".jsx",
      ".json",
      ".css"
    ]
  },
  "eslint": {
    "command": [
      "vscode-eslint-language-server",
      "--stdio"
    ],
    "extensions": [
      ".ts",
      ".tsx",
      ".js",
      ".jsx",
      ".vue"
    ]
  }
}